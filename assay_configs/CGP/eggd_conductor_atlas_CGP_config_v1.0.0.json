      "app-J8kvz9Q40ZP1v2Q7KV7fy1qG": {
        "name": "eggd_generate_variant_workbook",
        "details": "Generates a variant workbook from the VCF output of the atlas workflows",
        "url": "https://github.com/eastgenomics/eggd_generate_variant_workbook",
        "analysis": "analysis_3",
        "per_sample": true,
        "process_fastqs": false,
        "inputs": {
          "vcfs": {
            "$dnanexus_link": {
              "analysis": "analysis_2",
              "stage": "stage-eggd_vcf_rescue",
              "field": "output_vcf"
            }
          },
          "include_columns": "sampleName CHROM POS CSQ_SYMBOL CSQ_PANEL CSQ_Feature CSQ_EXON DNA Protein CSQ_HGVSp CSQ_Consequence CSQ_HGVSc DP AF FILTER CSQ_ClinVar CSQ_ClinVar_CLNSIG CSQ_ClinVar_CLNDN CSQ_Existing_variation CSQ_gnomADg_AF CSQ_gnomADe_AF CSQ_SpliceAI_pred_DS_AG CSQ_SpliceAI_pred_DS_AL CSQ_SpliceAI_pred_DS_DG CSQ_SpliceAI_pred_DS_DL CSQ_SpliceAI_pred_DP_AG CSQ_SpliceAI_pred_DP_AL CSQ_SpliceAI_pred_DP_DG CSQ_SpliceAI_pred_DP_DL CSQ_CADD_PHRED Prev_Count CSQ_EG_LC CSQ_EG_LCD CSQ_EG_LCS CSQ_EG_TC",
          "reorder_columns": "sampleName CHROM POS CSQ_SYMBOL CSQ_PANEL CSQ_Feature CSQ_EXON DNA Protein CSQ_HGVSp CSQ_Consequence CSQ_HGVSc DP AF FILTER CSQ_ClinVar CSQ_ClinVar_CLNSIG CSQ_ClinVar_CLNDN CSQ_Existing_variation CSQ_gnomADg_AF CSQ_gnomADe_AF CSQ_SpliceAI_pred_DS_AG CSQ_SpliceAI_pred_DS_AL CSQ_SpliceAI_pred_DS_DG CSQ_SpliceAI_pred_DS_DL CSQ_SpliceAI_pred_DP_AG CSQ_SpliceAI_pred_DP_AL CSQ_SpliceAI_pred_DP_DG CSQ_SpliceAI_pred_DP_DL CSQ_CADD_PHRED Prev_Count CSQ_EG_LC CSQ_EG_LCD CSQ_EG_LCS CSQ_EG_TC Allele_Origin Interpreted Reported Comment Classification MNV Report_text",
          "rename_columns": "CSQ_Existing_variation=dbSNP CSQ_Feature=Transcript_ID DP=Read_Depth CSQ_EG_LC=Latest_Classification CSQ_EG_LCD=Latest_Classification_Date CSQ_EG_LCS=Latest_Specimen_ID CSQ_EG_TC=Total_Classifications",
          "types": "CSQ_Prev_Count_AC=Float",
          "filter": "bcftools filter -e '(CSQ_Prev_Count_AC>853 || CSQ_gnomADg_AF >= 0.002 || CSQ_gnomADe_AF >= 0.002) || (CSQ_SYMBOL!=\"GATA2\" || CSQ_Consequence!=\"synonymous_variant\") && (CSQ_SYMBOL!=\"TP53\" || CSQ_Consequence!=\"synonymous_variant\") && (CSQ_Consequence==\"synonymous_variant\")'",
          "keep_filtered": true,
          "keep_tmp": false,
          "add_samplename_column": true,
          "add_allele_origin_column": true,
          "add_interpreted_column": true,
          "add_mnv_column": true,
          "add_reported_column": true,
          "add_comment_column": true,
          "add_classification_column": true,
          "add_report_text_column": true,
          "summary": "atlas",
          "split_hgvs": true,
          "af_format": "percent",
          "join_columns": "Prev_Count=CSQ_Prev_Count_AC,/,CSQ_Prev_Count_NS",
          "merge_vcfs": false,
          "add_auto_filter": true,
          "freeze_column": "J2",
          "lock_sheet": true,
          "m_codes": {
            "$dnanexus_link": {
              "project": "project-Fkb6Gkj433GVVvj73J7x8KbV",
              "id": "file-J2Gxb9j49q6yzjB933Xj36jB"
            }
          },
          "sort_by": "CSQ_SYMBOL:True"
        },
